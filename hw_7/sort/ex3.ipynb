      "Белое солнце пустыни 3\n",
      "Бриллиантовая рука 2\n",
      "Гараж 1\n"
     ]
    }
   ],
   "source": [
    "n = int(input())\n",
    "films = []\n",
    "for i in range(n):\n",
    "    films.append(input().strip())\n",
    "\n",
    "names = set(films)\n",
    "\n",
    "res = []\n",
    "for name in names:\n",
    "    res.append((films.count(name), name))\n",
    "\n",
    "res.sort(key=lambda x: -x[0])\n",
    "\n",
    "for c, name in res:\n",
    "    print(name, c)"
   ]
  }

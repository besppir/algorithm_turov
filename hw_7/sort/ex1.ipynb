   "source": [
    "a = list(map(int, input().split()))\n",
    "\n",
    "def is_min_heap(a):\n",
    "    for i in range(1, len(a)):\n",
    "        if a[(i - 1) // 2] > a[i]:\n",
    "            return 0\n",
    "    return 1\n",
    "\n",
    "print(is_min_heap(a))"
   ]
  }

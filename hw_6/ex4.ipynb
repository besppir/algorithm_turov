   "source": [
    "def to_upper(s):\n",
    "    if len(s) < 4:\n",
    "        if s.isupper():\n",
    "            print(s.upper())\n",
    "        else:\n",
    "            print(s)\n",
    "    else:\n",
    "        if sum(c.isupper() for c in s[:4]) >= 3:\n",
    "            print(s.upper())\n",
    "        else:\n",
    "            print(s)\n",
    "\n",
    "to_upper(input())"
   ]
  }
 ],

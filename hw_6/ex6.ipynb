   "source": [
    "def code(s):\n",
    "    if len(s) <= 2:\n",
    "        return ord(s[0])\n",
    "    elif len(s) < 10:\n",
    "        return ord(s[0]) + ord(s[(len(s) - 1) // 2]) + ord(s[-1])\n",
    "    else:\n",
    "        return ord(s[-1])\n",
    "\n",
    "print(code(input()))"
   ]
  }

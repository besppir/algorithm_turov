     "text": [
      "Длина окружности равно 12.57.\n",
      "Площадь круга составляет 139.63% от площади квадрата.\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "r, a = map(float, input().split())\n",
    "\n",
    "length = 2 * np.pi * r\n",
    "percent = np.pi * np.square(r) / np.square(a) * 100\n",
    "\n",
    "print(f'Длина окружности равно {length:.2f}.\\nПлощадь круга составляет {percent:.2f}% от площади квадрата.')"
   ]
  }
 ],
